# ─── SPECTRA Configuration ───────────────────────────────────────────────────

# Required: Anthropic API key
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: authenticate the Snyk CLI for local `spectra scan snyk` runs
# Get a token from your Snyk account; never commit the actual value.
SNYK_TOKEN=

# Optional: comma-separated browser origins allowed to call the API.
# Defaults to the local Vite dev server; production deployments should set explicit origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: require X-Spectra-API-Token on report and analysis API requests.
# Leave unset for local unauthenticated deployments.
# SPECTRA_API_TOKEN=replace-with-a-random-secret

# Optional: maximum uploaded scanner file size and retained reports.
SPECTRA_MAX_UPLOAD_BYTES=10485760
SPECTRA_MAX_REPORTS=100

# Optional: override default model (default: claude-sonnet-5-5)
# SPECTRA_MODEL=claude-opus-5-5
